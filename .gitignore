# Python virtual environments
.venv/
venv/
env/
ENV/

# Python byte-code and cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & quality caches
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE configurations
.idea/
.vscode/*
!.vscode/settings.json

# Large data files (to comply with GitHub 100MB limits)
data/raw/*
!data/raw/.gitkeep
data/processed/*.npy
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# Operating system artifacts
.DS_Store
Thumbs.db
