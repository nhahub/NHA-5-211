# SMART IDS v3 Environment Configuration
# Copy this file to .env and adjust values for your local environment.

SMART_IDS_ENV=development
SMART_IDS_SEED=42
SMART_IDS_DATA_DIR=data/raw
SMART_IDS_PROCESSED_DIR=data/processed
SMART_IDS_SYNTHETIC_DIR=data/synthetic
SMART_IDS_MODELS_DIR=models
SMART_IDS_ARTIFACTS_DIR=artifacts
SMART_IDS_REPORTS_DIR=reports
SMART_IDS_DRY_RUN=true
SMART_IDS_LOG_LEVEL=INFO
SMART_IDS_USE_GPU=auto
TF_CPP_MIN_LOG_LEVEL=2
